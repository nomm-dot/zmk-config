#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Define layer numbers for cleaner code
#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6

/ {
    macros {
            // Combine shift with bluetooh profile to clear it
            bt_clr_0: bt_clr_0 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <100>; // Wait 100ms between commands
                bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
            };
            bt_clr_1: bt_clr_1 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <100>;
                bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
            };
            bt_clr_2: bt_clr_2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <100>;
                bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;
            };
            bt_clr_3: bt_clr_3 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <100>;
                bindings = <&bt BT_SEL 3>, <&bt BT_CLR>;
            };
        };
    
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Mod-Morph: Backspace normally, Delete when Shifted
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Define a custom 0-cell Hold-Tap to wrap the Mod-Morph and the Num layer
        num_bspc: num_layer_bspc_del {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // Hold activates Layer 4 (NUM), Tap activates Mod-Morph
            bindings = <&mo>, <&bspc_del>; 
        };

        // Combine shift with bluetooh profile to clear it
        bt_0: bt_0_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt_clr_0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        bt_1: bt_1_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt_clr_1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        bt_2: bt_2_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt_clr_2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        bt_3: bt_3_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt_clr_3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                   &kp Q      &kp W      &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O      &kp P
                   &hm LGUI A &hm LALT S &hm LCTRL D &hm LSHFT F &kp G           &kp H       &hm LSHFT J &hm LCTRL K &hm LALT L &hm LGUI SQT
        &none      &kp Z      &kp X      &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT    &kp FSLH      &none
                                         &lt MEDIA ESC &lt NAV SPACE &lt MOUSE TAB &lt SYM RET &num_bspc NUM 0 &lt FUN DEL
            >;
        };


        nav_layer {
            display-name = "NAV";
            bindings = <
                   &trans     &trans     &trans      &trans      &trans          &kp K_REDO  &kp K_PASTE &kp K_COPY  &kp K_CUT  &kp K_UNDO
                   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans          &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT  &caps_word
        &none      &trans     &trans     &trans      &trans      &trans          &kp HOME    &kp PG_DN   &kp PG_UP   &kp END    &kp INS     &none
                                         &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

        mouse_layer {
            // Note: True ZMK mouse movement requires a dedicated PR/Module. 
            // This is laid out for future integration, currently falling back to trans.
            display-name = "MOUSE";
            bindings = <
                   &trans     &trans     &trans      &trans      &trans          &trans      &trans      &trans      &trans     &trans
                   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans          &trans      &trans      &trans      &trans     &trans
        &none      &trans     &trans     &trans      &trans      &trans          &trans      &trans      &trans      &trans     &trans         &none
                                         &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
                   &trans     &trans     &trans      &trans      &trans          &tog FUN      &kp C_BRI_DN  &kp C_BRI_UP  &trans       &studio_unlock
                   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans          &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT   &trans
        &none      &trans     &trans     &trans      &trans      &trans          &bt_0         &bt_1         &bt_2         &bt_3        &out OUT_TOG   &none
                                         &trans      &trans      &trans          &kp C_STOP    &kp C_PLAY_PAUSE &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                   &kp LBKT   &kp N7     &kp N8      &kp N9      &kp RBKT        &trans      &trans      &trans      &trans     &trans
                   &kp SEMI   &kp N4     &kp N5      &kp N6      &kp EQUAL       &trans      &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI
        &none      &kp GRAVE  &kp N1     &kp N2      &kp N3      &kp BSLH        &trans      &trans      &trans      &trans     &trans       &none
                                         &kp DOT     &kp N0      &kp MINUS       &trans      &trans      &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                   &kp LBRC   &kp AMPS   &kp ASTRK   &kp LPAR    &kp RBRC        &trans      &trans      &trans      &trans     &trans
                   &kp DQT    &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS        &trans      &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI
        &none      &kp TILDE  &kp EXCL   &kp AT      &kp HASH    &kp PIPE        &trans      &trans      &trans      &trans     &trans       &none
                                         &kp LPAR    &kp RPAR    &kp UNDER       &trans      &trans      &trans
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
                   &kp F12    &kp F7     &kp F8      &kp F9      &kp PSCRN       &trans      &trans      &trans      &trans     &trans
                   &kp F11    &kp F4     &kp F5      &kp F6      &kp SLCK        &trans      &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI
        &none      &kp F10    &kp F1     &kp F2      &kp F3      &kp PAUSE_BREAK &trans      &trans      &trans      &trans     &trans       &none
                                         &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };
    };
};
