// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define EXTRA 1
#define TAP 2
#define NAV 3
#define MEDIA 4
#define NUM 5
#define SYM 6
#define FUN 7

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
               &kp Q      &kp W      &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O      &kp P
    &none      &hm LGUI A &hm LALT S &hm LCTRL D &hm LSHFT F &kp G           &kp H       &hm RSHFT J &hm RCTRL K &hm RALT L &hm RGUI SQT &none
               &kp Z      &kp X      &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT    &kp FSLH
                                     &lt MEDIA ESC &lt NAV SPACE &kp TAB     &lt SYM RET &lt NUM BSPC &lt FUN DEL
            >;
        };

        extra_layer {
            display-name = "Colemak";
            bindings = <
               &kp Q      &kp W      &kp F       &kp P       &kp G           &kp J       &kp L       &kp U       &kp Y      &kp SQT
    &none      &hm LGUI A &hm LALT R &hm LCTRL S &hm LSHFT T &kp D           &kp H       &hm RSHFT N &hm RCTRL E &hm RALT I &hm RGUI O   &none
               &kp Z      &kp X      &kp C       &kp V       &kp B           &kp K       &kp M       &kp COMMA   &kp DOT    &kp FSLH
                                     &lt MEDIA ESC &lt NAV SPACE &kp TAB     &lt SYM RET &lt NUM BSPC &lt FUN DEL
            >;
        };

        tap_layer {
            display-name = "Tap";
            bindings = <
               &kp Q      &kp W      &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O      &kp P
    &none      &kp A      &kp S      &kp D       &kp F       &kp G           &kp H       &kp J       &kp K       &kp L      &kp SQT    &none
               &kp Z      &kp X      &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT    &kp FSLH
                                     &kp ESC     &kp SPACE   &kp TAB         &kp RET     &kp BSPC    &kp DEL
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
               &none      &none      &none       &none       &none           &none       &none       &none       &none      &none
    &none      &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none           &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT  &none      &none
               &none      &none      &none       &none       &none           &kp HOME    &kp PG_DN   &kp PG_UP   &kp END    &none
                                     &none       &none       &none           &kp RET     &kp BSPC    &kp DEL
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
               &tog TAP   &tog EXTRA &none       &none       &none           &none        &none        &none        &none        &none
    &none      &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none           &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &none      &none
               &none      &none      &none       &none       &none           &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                                     &none       &none       &none           &kp C_STOP   &kp C_PP     &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
               &kp LBKT   &kp N7     &kp N8      &kp N9      &kp RBKT        &none       &none       &none       &none      &none
    &none      &kp SQT    &kp N4     &kp N5      &kp N6      &kp EQUAL       &none       &kp RSHFT   &kp RCTRL   &kp RALT   &kp RGUI   &none
               &kp GRAVE  &kp N1     &kp N2      &kp N3      &kp BSLH        &none       &none       &none       &none      &none
                                     &kp DOT     &kp N0      &kp MINUS       &none       &none       &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
               &kp LBRC   &kp AMPS   &kp ASTRK   &kp LPAR    &kp RBRC        &none       &none       &none       &none      &none
    &none      &kp DQT    &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS        &none       &kp RSHFT   &kp RCTRL   &kp RALT   &kp RGUI   &none
               &kp TILDE  &kp EXCL   &kp AT      &kp HASH    &kp PIPE        &none       &none       &none       &none      &none
                                     &kp LPAR    &kp RPAR    &kp UNDER       &none       &none       &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
               &kp F12    &kp F7     &kp F8      &kp F9      &kp PSCRN       &none       &none       &none       &none      &none
    &none      &kp F11    &kp F4     &kp F5      &kp F6      &kp SLCK        &none       &kp RSHFT   &kp RCTRL   &kp RALT   &kp RGUI   &none
               &kp F10    &kp F1     &kp F2      &kp F3      &kp PAUSE_BREAK &none       &none       &none       &none      &none
                                     &kp K_APP   &kp SPACE   &kp TAB         &none       &none       &none
            >;
        };
    };
};
